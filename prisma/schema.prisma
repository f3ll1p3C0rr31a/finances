generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  incomeTemplates   IncomeTemplate[]
  incomeEntries     IncomeEntry[]
  expenseTemplates  ExpenseTemplate[]
  expenseEntries    ExpenseEntry[]
  monthlyBalances   MonthlyBalance[]
  cards             Card[]
  cardSpendingGoals CardSpendingGoal[]
}

enum PaidBy {
  SELF
  THIRD_PARTY
}

enum DueDayType {
  CALENDAR_DAY
  BUSINESS_DAY
}

enum ExpenseCategory {
  FIXED
  VARIABLE
  ONE_OFF
}

/// A recurring income rule (e.g. monthly salary). One-time income is
/// created directly as an IncomeEntry with no template.
model IncomeTemplate {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  defaultAmount Decimal   @db.Decimal(12, 2)
  dayOfMonth    Int?
  dueDayType    DueDayType @default(CALENDAR_DAY)
  startMonth    DateTime  @db.Date
  endMonth      DateTime? @db.Date
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())

  entries IncomeEntry[]

  @@index([userId])
}

/// One concrete month's income row, either generated from a template
/// or created directly as a one-off.
model IncomeEntry {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId     String?
  template       IncomeTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  name           String
  month          DateTime  @db.Date
  dueDate        DateTime? @db.Date
  dueDayType     DueDayType @default(CALENDAR_DAY)
  dueDayValue    Int?
  amount         Decimal   @db.Decimal(12, 2)
  received       Boolean   @default(false)
  receivedAt     DateTime?
  receivedAmount Decimal?  @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([templateId, month])
  @@index([userId, month])
}

/// A recurring expense rule (e.g. Pensão, Aluguel). One-time expenses
/// (e.g. "Atrasada") are created directly as an ExpenseEntry with no template.
model ExpenseTemplate {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  category      ExpenseCategory
  defaultAmount Decimal?        @db.Decimal(12, 2)
  dayOfMonth    Int?
  dueDayType    DueDayType      @default(CALENDAR_DAY)
  startMonth    DateTime        @db.Date
  endMonth      DateTime?       @db.Date
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now())

  entries ExpenseEntry[]

  @@index([userId])
}

/// One concrete month's expense row, either generated from a template
/// or created directly as a one-off.
model ExpenseEntry {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId String?
  template   ExpenseTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  name       String
  category   ExpenseCategory
  month      DateTime        @db.Date
  dueDate    DateTime?       @db.Date
  dueDayType DueDayType      @default(CALENDAR_DAY)
  dueDayValue Int?
  amount     Decimal         @db.Decimal(12, 2)
  paid       Boolean         @default(false)
  paidAt     DateTime?
  paidAmount Decimal?        @db.Decimal(12, 2)
  paidBy     PaidBy          @default(SELF)
  paidByName String?
  notes      String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([templateId, month])
  @@index([userId, month])
}

/// One row per month per user. openingBalance is derived from the prior
/// month's actualBalance (or computed planned balance) and denormalized
/// here for fast reads. actualBalance is the manually-updated real
/// bank balance ("Saldo") and, once set, becomes the source of truth
/// carried forward to the next month's openingBalance.
model MonthlyBalance {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  month           DateTime  @db.Date
  openingBalance  Decimal   @db.Decimal(12, 2)
  actualBalance   Decimal?  @db.Decimal(12, 2)
  actualBalanceAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, month])
}

/// A credit card. Each card's purchases and totals are tracked
/// independently of the other cards; only the monthly spending goal
/// compares their combined total.
model Card {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  closingDay Int?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  purchases CardPurchase[]

  @@index([userId])
}

/// A single-payment purchase (installmentCount = 1, no CardInstallment
/// rows, counted in the month of purchaseDate) or the head of an
/// installment plan (installmentCount > 1, split across CardInstallment
/// rows generated up front since the plan is fixed at purchase time).
model CardPurchase {
  id               String   @id @default(cuid())
  cardId           String
  card             Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  description      String
  totalAmount      Decimal  @db.Decimal(12, 2)
  purchaseDate     DateTime @db.Date
  installmentCount Int      @default(1)
  createdAt        DateTime @default(now())

  installments CardInstallment[]

  @@index([cardId, purchaseDate])
}

/// One future month's slice of an installment purchase.
model CardInstallment {
  id            String       @id @default(cuid())
  purchaseId    String
  purchase      CardPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  installmentNo Int
  month         DateTime     @db.Date
  amount        Decimal      @db.Decimal(12, 2)

  @@unique([purchaseId, installmentNo])
  @@index([month])
}

/// Combined monthly spending goal across all cards.
model CardSpendingGoal {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month  DateTime @db.Date
  amount Decimal  @db.Decimal(12, 2)

  @@unique([userId, month])
}
