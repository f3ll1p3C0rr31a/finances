generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  incomeTemplates   IncomeTemplate[]
  incomeEntries     IncomeEntry[]
  expenseTemplates  ExpenseTemplate[]
  expenseEntries    ExpenseEntry[]
  monthlyBalances   MonthlyBalance[]
  cards             Card[]
  cardSpendingGoals CardSpendingGoal[]
  tags              Tag[]
  accounts          Account[]
  pixKeys           PixKey[]
  subscriptions     Subscription[]
  pluggyConnections PluggyConnection[]
}

enum PaidBy {
  SELF
  THIRD_PARTY
}

enum DueDayType {
  CALENDAR_DAY
  BUSINESS_DAY
}

enum ExpenseCategory {
  FIXED
  VARIABLE
  ONE_OFF
}

enum PaymentMethod {
  CASH
  PIX
  TRANSFER
  BOLETO
  CARD
  OTHER
}

enum PixKeyKind {
  OWN
  PAYEE
}

enum PixKeyType {
  PHONE
  CPF
  CNPJ
  EMAIL
  RANDOM
}

enum Currency {
  BRL
  USD
}

enum PluggyAccountType {
  BANK
  CREDIT
}

enum PluggyImportTarget {
  EXPENSE
  INCOME
  CARD_PURCHASE
}

/// A recurring income rule (e.g. monthly salary). One-time income is
/// created directly as an IncomeEntry with no template.
model IncomeTemplate {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  defaultAmount Decimal    @db.Decimal(12, 2)
  dayOfMonth    Int?
  dueDayType    DueDayType @default(CALENDAR_DAY)
  startMonth    DateTime   @db.Date
  endMonth      DateTime?  @db.Date
  active        Boolean    @default(true)
  createdAt     DateTime   @default(now())

  entries IncomeEntry[]

  @@index([userId])
}

/// One concrete month's income row, either generated from a template
/// or created directly as a one-off.
model IncomeEntry {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId     String?
  template       IncomeTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  name           String
  month          DateTime        @db.Date
  dueDate        DateTime?       @db.Date
  dueDayType     DueDayType      @default(CALENDAR_DAY)
  dueDayValue    Int?
  amount         Decimal         @db.Decimal(12, 2)
  received       Boolean         @default(false)
  receivedAt     DateTime?
  receivedAmount Decimal?        @db.Decimal(12, 2)
  uncertain      Boolean         @default(false)
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  tags IncomeEntryTag[]

  @@unique([templateId, month])
  @@index([userId, month])
}

/// A recurring expense rule (e.g. Pensão, Aluguel). One-time expenses
/// (e.g. "Atrasada") are created directly as an ExpenseEntry with no template.
model ExpenseTemplate {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  category      ExpenseCategory
  defaultAmount Decimal?        @db.Decimal(12, 2)
  dayOfMonth    Int?
  dueDayType    DueDayType      @default(CALENDAR_DAY)
  startMonth    DateTime        @db.Date
  endMonth      DateTime?       @db.Date
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now())

  entries ExpenseEntry[]

  @@index([userId])
}

/// One concrete month's expense row, either generated from a template
/// or created directly as a one-off.
model ExpenseEntry {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId    String?
  template      ExpenseTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  name          String
  category      ExpenseCategory
  month         DateTime         @db.Date
  dueDate       DateTime?        @db.Date
  dueDayType    DueDayType       @default(CALENDAR_DAY)
  dueDayValue   Int?
  amount        Decimal          @db.Decimal(12, 2)
  paid          Boolean          @default(false)
  paidAt        DateTime?
  paidAmount    Decimal?         @db.Decimal(12, 2)
  uncertain     Boolean          @default(false)
  paidBy        PaidBy           @default(SELF)
  paidByName    String?
  paymentMethod PaymentMethod    @default(PIX)
  pixKeyId      String?
  pixKey        PixKey?          @relation(fields: [pixKeyId], references: [id], onDelete: SetNull)
  externalLink  String?
  attachmentFileName String?
  attachmentPath     String?
  attachmentUploadedAt DateTime?
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  tags ExpenseEntryTag[]

  @@unique([templateId, month])
  @@index([userId, month])
}

/// One row per month per user. openingBalance is derived from the prior
/// month's actualBalance (or computed planned balance) and denormalized
/// here for fast reads. actualBalance is the manually-updated real
/// bank balance ("Saldo") and, once set, becomes the source of truth
/// carried forward to the next month's openingBalance.
model MonthlyBalance {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  month           DateTime  @db.Date
  openingBalance  Decimal   @db.Decimal(12, 2)
  actualBalance   Decimal?  @db.Decimal(12, 2)
  actualBalanceAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, month])
}

/// A credit card. Each card's purchases and totals are tracked
/// independently of the other cards; only the monthly spending goal
/// compares their combined total.
model Card {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId       String?
  account         Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  name            String
  closingDay      Int?
  bestPurchaseDay Int?
  paymentDay      Int?
  creditLimit     Decimal? @db.Decimal(12, 2)
  cardNumber      String?
  cvv             String?
  expiryMonth     Int?
  expiryYear      Int?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  purchases       CardPurchase[]
  subscriptions   Subscription[]
  invoicePayments CardInvoicePayment[]
  pluggyLink      PluggyAccountLink?

  @@index([userId])
  @@index([accountId])
}

/// Payment state for one card invoice in one month. paidAmount stores the
/// invoice total applied to the real balance so unchecking can reverse the
/// exact same amount even if purchases are edited later.
model CardInvoicePayment {
  id         String    @id @default(cuid())
  cardId     String
  card       Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  month      DateTime  @db.Date
  paid       Boolean   @default(false)
  paidAt     DateTime?
  paidAmount Decimal?  @db.Decimal(12, 2)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([cardId, month])
  @@index([month])
}

/// A single-payment purchase (installmentCount = 1, no CardInstallment
/// rows, counted in billingMonth) or the head of an
/// installment plan (installmentCount > 1, split across CardInstallment
/// rows generated up front since the plan is fixed at purchase time).
model CardPurchase {
  id               String    @id @default(cuid())
  cardId           String
  card             Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  description      String
  totalAmount      Decimal   @db.Decimal(12, 2)
  purchaseDate     DateTime  @db.Date
  billingMonth     DateTime? @db.Date
  installmentCount Int       @default(1)
  hasInterest      Boolean   @default(false)
  createdAt        DateTime  @default(now())

  installments CardInstallment[]
  tags         CardPurchaseTag[]

  @@index([cardId, purchaseDate])
  @@index([cardId, billingMonth])
}

/// One future month's slice of an installment purchase.
model CardInstallment {
  id            String       @id @default(cuid())
  purchaseId    String
  purchase      CardPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  installmentNo Int
  month         DateTime     @db.Date
  amount        Decimal      @db.Decimal(12, 2)

  @@unique([purchaseId, installmentNo])
  @@index([month])
}

/// Combined monthly spending goal across all cards.
model CardSpendingGoal {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month  DateTime @db.Date
  amount Decimal  @db.Decimal(12, 2)

  @@unique([userId, month])
}

/// A free-form spending category (e.g. "Entretenimento", "Gasolina").
/// Applies to card purchases, subscriptions and income/expense entries alike.
model Tag {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String

  cardPurchases  CardPurchaseTag[]
  incomeEntries  IncomeEntryTag[]
  expenseEntries ExpenseEntryTag[]
  subscriptions  SubscriptionTag[]

  @@unique([userId, name])
}

model CardPurchaseTag {
  purchaseId String
  purchase   CardPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  tagId      String
  tag        Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([purchaseId, tagId])
}

model IncomeEntryTag {
  entryId String
  entry   IncomeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  tagId   String
  tag     Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([entryId, tagId])
}

model ExpenseEntryTag {
  entryId String
  entry   ExpenseEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  tagId   String
  tag     Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([entryId, tagId])
}

model SubscriptionTag {
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  tagId          String
  tag            Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([subscriptionId, tagId])
}

/// A bank account the user tracks for reference (not a source of
/// automated data — just a note of which accounts exist and whether
/// they're still in use).
model Account {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  bankName      String?
  bankCode      String?
  agency        String?
  accountNumber String?
  accountDigit  String?
  accountType   String?
  holderName    String?
  active        Boolean  @default(true)
  notes         String?
  createdAt     DateTime @default(now())

  cards      Card[]
  pixKeys    PixKey[]
  pluggyLink PluggyAccountLink?

  @@index([userId])
}

/// A Pix key — either one of the user's own (to receive) or a
/// frequent payee's (to pay), kept for quick reference. Expense
/// entries can link to a PAYEE key to record who a bill is paid to.
model PixKey {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId String?
  account   Account?   @relation(fields: [accountId], references: [id], onDelete: SetNull)
  kind      PixKeyKind
  keyType   PixKeyType?
  label     String
  keyValue  String
  destinationBankName String?
  destinationBankCode String?
  notes     String?
  createdAt DateTime   @default(now())

  expenseEntries ExpenseEntry[]

  @@index([userId])
  @@index([accountId])
}

/// A recurring charge with no fixed end (unlike a CardPurchase
/// installment plan) that stays active until cancelled. When paid by
/// card it contributes to that card's monthly total; otherwise it
/// contributes to the regular monthly expense total the same way a
/// recurring ExpenseEntry would.
model Subscription {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  amount         Decimal       @db.Decimal(12, 2)
  currency       Currency      @default(BRL)
  originalAmount Decimal?      @db.Decimal(12, 2)
  exchangeRate   Decimal?      @db.Decimal(12, 4)
  paymentMethod  PaymentMethod
  cardId         String?
  card           Card?         @relation(fields: [cardId], references: [id], onDelete: SetNull)
  active         Boolean       @default(true)
  /// Day of the calendar month the provider charges this subscription.
  chargeDay      Int           @default(1)
  logoDomain     String?
  startMonth     DateTime      @db.Date
  /// Exact cancellation date. Charges due on or before it stay billed;
  /// charges after it stop. Reactivating clears it and moves startMonth
  /// forward so the cancelled gap is never billed retroactively.
  cancelledAt    DateTime?     @db.Date
  createdAt      DateTime      @default(now())

  tags    SubscriptionTag[]
  charges SubscriptionCharge[]

  @@index([userId])
  @@index([cardId])
}

/// One Pluggy Item: a live connection to a financial institution, created
/// by the user through the Pluggy Connect widget. Holds no credentials —
/// Pluggy keeps those; we only store the item id needed to read data.
model PluggyConnection {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId          String    @unique
  connectorId     Int
  connectorName   String
  connectorImageUrl String?
  status          String
  executionStatus String?
  lastSyncedAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  accountLinks PluggyAccountLink[]

  @@index([userId])
}

/// Maps one account inside a Pluggy connection to the local Account
/// (checking account) or Card it feeds. Until linked, nothing is imported
/// from it. `transactionsCursor` makes each sync incremental.
model PluggyAccountLink {
  id                 String            @id @default(cuid())
  connectionId       String
  connection         PluggyConnection  @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  pluggyAccountId    String            @unique
  type               PluggyAccountType
  name               String
  numberLast4        String?
  accountId          String?           @unique
  account            Account?          @relation(fields: [accountId], references: [id], onDelete: SetNull)
  cardId             String?           @unique
  card               Card?             @relation(fields: [cardId], references: [id], onDelete: SetNull)
  /// Whether this account's balance counts toward the month's real balance.
  includeInBalance   Boolean           @default(true)
  lastBalance        Decimal?          @db.Decimal(12, 2)
  lastBalanceAt      DateTime?
  /// Watermark for incremental sync: only transactions created at Pluggy
  /// after this instant are fetched next time. Null means "never synced",
  /// which pulls the full available history.
  transactionsSyncedAt DateTime?
  createdAt          DateTime          @default(now())

  importedTransactions PluggyImportedTransaction[]

  @@index([connectionId])
}

/// Audit/tombstone row: its existence (keyed by pluggyTransactionId) is what
/// prevents re-import, independent of whether targetId still points to a live
/// record — deleting the imported ExpenseEntry/IncomeEntry/CardPurchase never
/// makes it come back on the next sync. targetId is a plain id with no FK on
/// purpose, since it points across three different models.
model PluggyImportedTransaction {
  id                  String             @id @default(cuid())
  accountLinkId       String
  accountLink         PluggyAccountLink  @relation(fields: [accountLinkId], references: [id], onDelete: Cascade)
  pluggyTransactionId String             @unique
  targetType          PluggyImportTarget
  targetId            String?
  amount              Decimal            @db.Decimal(12, 2)
  description         String
  transactionDate     DateTime           @db.Date
  importedAt          DateTime           @default(now())

  @@index([accountLinkId])
  @@index([targetId])
}

/// One materialized monthly charge of a subscription. Created when the
/// charge date is reached (generation is lazy and idempotent), so past
/// charges survive later cancellation, card switches or price edits.
/// `month` is the calendar month of chargeDate; `billingMonth` is the
/// invoice month the charge lands on (card cycle applied) and equals
/// `month` for non-card subscriptions.
model SubscriptionCharge {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  chargeDate     DateTime     @db.Date
  month          DateTime     @db.Date
  billingMonth   DateTime     @db.Date
  amount         Decimal      @db.Decimal(12, 2)
  createdAt      DateTime     @default(now())

  @@unique([subscriptionId, month])
  @@index([billingMonth])
}
