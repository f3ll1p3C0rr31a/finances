<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_month"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textColor="#a5b4fc"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:text="@string/app_name" />

        <ImageView
            android:id="@+id/widget_refresh"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_refresh"
            android:contentDescription="@string/widget_refresh" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_planned"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#f8fafc"
        android:textSize="26sp"
        android:textStyle="bold"
        android:text="—" />

    <TextView
        android:id="@+id/widget_current"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#94a3b8"
        android:textSize="12sp"
        android:text="" />

    <TextView
        android:id="@+id/widget_goal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#cbd5e1"
        android:textSize="12sp"
        android:text="" />

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="#64748b"
        android:textSize="11sp"
        android:text="" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:background="@drawable/widget_button"
        android:padding="8dp"
        android:textColor="#f8fafc"
        android:textSize="12sp"
        android:textStyle="bold"
        android:text="@string/widget_quick_purchase" />
</LinearLayout>
