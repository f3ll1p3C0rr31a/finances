DATABASE_URL="postgresql://finances:finances_dev_password@localhost:5432/finances"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Used only by prisma/seed.ts to create the single app user
SEED_USER_EMAIL="you@example.com"
SEED_USER_PASSWORD="choose-a-strong-password"

# Digital Asset Links do app Android (TWA). Impressão digital SHA-256 da chave
# que assina o APK; aceita várias separadas por vírgula. Sem isso o app abre
# com a barra do Chrome por cima. Ver android/README.md.
ANDROID_APP_FINGERPRINT=""
ANDROID_APP_PACKAGE="com.fellipecorreia.fortuna"
