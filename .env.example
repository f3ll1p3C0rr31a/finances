DATABASE_URL="postgresql://finances:finances_dev_password@localhost:5432/finances"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Used only by prisma/seed.ts to create the single app user
SEED_USER_EMAIL="you@example.com"
SEED_USER_PASSWORD="choose-a-strong-password"

# Pluggy (open finance) — credentials come from the Pluggy developer dashboard.
# Without them the Conexões page stays disabled and nothing else is affected.
PLUGGY_CLIENT_ID=""
PLUGGY_CLIENT_SECRET=""
# Any random string; must match the Authorization header registered with the
# Pluggy webhook, since Pluggy does not sign its payloads.
PLUGGY_WEBHOOK_SECRET=""
# Public HTTPS origin of this app, used to build the webhook URL.
APP_PUBLIC_URL=""
